FROM mcr.microsoft.com/playwright/python:v1.63.0-noble

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/bin/python3 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages/auditor/pyproject.toml packages/auditor/pyproject.toml
COPY services/app/pyproject.toml services/app/pyproject.toml
RUN mkdir -p packages/auditor/auditor services/app/app \
    && uv sync --frozen --no-dev --no-install-workspace

COPY packages/auditor packages/auditor
COPY services/app services/app
COPY fixtures fixtures
COPY study study
COPY eval/detector eval/detector
COPY CHECK_CATALOGUE.md ./
RUN uv sync --frozen --no-dev \
    && python -c "import importlib.metadata as m; assert m.version('playwright') == '1.63.0'" \
    && ! python -c "import torch" 2>/dev/null

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /data && chown app:app /data

ENV DATA_DIR=/data \
    AUDITOR_DETECTOR=/data/models/detector.onnx \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    HOME=/home/app

USER app
VOLUME /data
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"

CMD ["uvicorn", "app.main:app", "--app-dir", "services/app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
