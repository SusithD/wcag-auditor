# Copy to .env and adjust. Paths are relative to the repo root.
BENCHMARK_DIR=../04_Data_Collection/benchmark_captures
TRUTH_PATH=../04_Data_Collection/annotation/benchmark_ground_truth.json
SYNTHETIC_DIR=../04_Data_Collection/synthetic_corpus_v1.1
AXE_SOURCE=../04_Data_Collection/vendor/axe.min.js
DATA_DIR=./data
APP_PORT=8000
WEB_PORT=3000
# Production (see docs/DEPLOY.md and deploy/.env.example)
AUDITOR_DETECTOR=./data/models/detector.onnx
AUDIT_PDF=1
JOB_TIMEOUT_S=900
FOLDER_ROOTS=./fixtures
STUDY_ADMIN_TOKEN=
STUDY_ETHICS_APPROVED=0
DECIDED_BY_NAME=Local user
# Training (Apple silicon)
PYTORCH_ENABLE_MPS_FALLBACK=1
